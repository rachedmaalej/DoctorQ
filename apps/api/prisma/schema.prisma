// DoctorQ Database Schema
// Virtual Queue Management for Tunisia Medical Practices

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // For direct connections (migrations), use DIRECT_URL if available
  // pgbouncer doesn't support DDL transactions, so migrations need a direct connection
  directUrl = env("DIRECT_URL")
}

// Connection Pool Configuration:
// - Supabase pgbouncer (pooler URL) handles pooling in production
// - Add ?connection_limit=10&pool_timeout=30 to DATABASE_URL for tuning
// - Use DIRECT_URL for migrations when using pgbouncer

model Clinic {
  id                  String       @id @default(uuid())
  name                String
  doctorName          String?
  doctorGender        String?            // "M" or "F"
  phone               String?
  address             String?
  language            String       @default("fr") // fr, ar
  avgConsultationMins Int          @default(10)
  isActive            Boolean      @default(true)

  // Auth
  email               String       @unique
  passwordHash        String

  // Settings
  notifyAtPosition    Int          @default(2)  // Notify when X patients away
  enableWhatsApp      Boolean      @default(false)
  isDoctorPresent     Boolean      @default(false)  // Track if doctor is currently seeing patients
  multiDoctorEnabled  Boolean      @default(false)  // Admin-controlled: unlock multi-doctor management

  // Announcement to all patients (displayed as banner on patient status page)
  announcement        String?      // Active announcement text (null = no announcement)
  announcementAt      DateTime?    // When the announcement was set

  // Queue rules
  queueMode           String       @default("RDV_PRIORITY")  // RDV_PRIORITY | FIFO | RDV_ON_TIME
  rdvGraceMinutes     Int          @default(15)              // Grace period for RDV_ON_TIME mode (5-30 min)
  enableStepOut       Boolean      @default(false)           // Allow patients to temporarily step out of queue

  // Business type customization
  businessType        String       @default("medical")  // medical, retail, restaurant, etc.
  showAppointments    Boolean      @default(true)       // Whether to show appointment time field

  // Specialty & fun facts
  specialty           String?      // Medical specialty (ophthalmology, dentistry, cardiology, etc.)
  funFactsEnabled     Boolean      @default(true)  // Show fun facts on patient status page

  // Localization settings
  country                String    @default("TN")    // TN = Tunisia, FR = France
  enableLanguageSwitcher Boolean   @default(true)    // Show/hide language toggle on public pages

  // NOTE: The following fields are defined in the plan but NOT yet migrated to DB.
  // They are commented out until `prisma db push` or `prisma migrate` can run
  // against the database. The new settings panels use local defaults until then.
  // clinicHours            Json?
  // enableQrCode           Boolean   @default(true)
  // enableManualEntry      Boolean   @default(true)
  // defaultCheckInMethod   CheckInMethod @default(MANUAL)
  // notificationSoundEnabled Boolean @default(true)
  // quietHoursStart        String?
  // quietHoursEnd          String?
  // welcomeMessage         String?
  // showQueuePosition      Boolean   @default(true)
  // showEstimatedWait      Boolean   @default(true)

  // Activity tracking
  lastLoginAt         DateTime?    // Last login timestamp for churn detection
  lastDailyResetAt    DateTime?    // Last successful midnight reset (for lazy cleanup)

  // Subscription fields (for self-service)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      SubscriptionPlan?
  trialEndsAt           DateTime?          // When free trial expires
  subscriptionEndsAt    DateTime?          // When paid subscription expires

  // Email verification
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?

  // Password reset
  passwordResetToken    String?   @unique
  passwordResetExpiry   DateTime?

  // Onboarding
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        Int       @default(0)

  // Activation checklist (backend-persisted)
  activationQrDownloaded       Boolean   @default(false)
  activationFirstPatient       Boolean   @default(false)
  activationChecklistDismissed Boolean   @default(false)

  // Behavior-triggered email tracking (for future cron jobs)
  qrReminderSentAt             DateTime?
  noPatientReminderSentAt      DateTime?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  queueEntries          QueueEntry[]
  dailyStats            DailyStat[]
  hourlyStats           HourlyStat[]
  doctorDailyStats      DoctorDailyStat[]
  paymentRecords        PaymentRecord[]
  subscriptionEvents    SubscriptionEvent[]
  doctors               Doctor[]
  patients              Patient[]

  @@index([email])
  @@index([subscriptionStatus])
  @@index([trialEndsAt])
}

model Doctor {
  id                  String   @id @default(uuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name                String
  specialty           String?
  isActive            Boolean  @default(true)
  avgConsultationMins Int      @default(15)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  queueEntries        QueueEntry[]

  @@index([clinicId, isActive])
}

model Patient {
  id          String      @id @default(uuid())
  clinicId    String
  name        String
  phone       String?
  visitCount  Int         @default(1)
  lastVisitAt DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?   // Soft-delete for data compliance

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  entries     QueueEntry[]

  @@unique([clinicId, phone])
  @@index([clinicId, name])
  @@index([clinicId, lastVisitAt])
}

model QueueEntry {
  id            String        @id @default(uuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  // Multi-doctor support (nullable for backward compatibility)
  doctorId      String?
  doctor        Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  patientName   String?
  patientPhone  String
  position      Int

  status        QueueStatus   @default(WAITING)
  checkInMethod CheckInMethod @default(MANUAL)

  // Appointment support (v0.3)
  appointmentTime DateTime?   // Scheduled appointment time (null = walk-in)

  // Emergency flag — patient goes to #2 (right after current consultation)
  isEmergency   Boolean       @default(false)

  // Stepped-out flag — patient temporarily left the waiting room
  isSteppedOut  Boolean       @default(false)
  stepOutCount  Int           @default(0)    // How many times patient has stepped out (max 2)
  steppedOutAt  DateTime?                    // When patient stepped out (for 60-min timeout)

  // Manual reordering support
  // When set, this patient's position is "pinned" and won't be auto-recalculated
  // Value is the timestamp when manually reordered (used for ordering pinned patients)
  priorityOrder DateTime?

  arrivedAt     DateTime      @default(now())
  notifiedAt    DateTime?     // When "almost your turn" sent
  calledAt      DateTime?     // When called for consultation
  completedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Patient record link (for autocomplete & visit tracking)
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id])

  pushSubscriptions PushSubscription[]

  // Performance indexes for common queries
  @@index([clinicId, status])                       // Filter active queue by clinic
  @@index([clinicId, arrivedAt])                    // Order by arrival time
  @@index([clinicId, createdAt])                    // Order by creation time
  @@index([clinicId, appointmentTime])              // Order by appointment time
  @@index([clinicId, status, position])             // Queue recalculation queries
  @@index([clinicId, status, arrivedAt])            // Duplicate check (phone + status + date)
  @@index([clinicId, patientPhone, status])         // Fast duplicate detection
  @@index([patientPhone])                           // Global phone lookup
  @@index([status, completedAt])                    // Stats: last completed patient
  @@index([clinicId, calledAt])                     // Stats: average wait time calculation
  @@index([doctorId])                               // Multi-doctor queue filtering
}

enum QueueStatus {
  WAITING
  NOTIFIED      // "Almost your turn" sent
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum CheckInMethod {
  QR_CODE
  MANUAL
  WHATSAPP
}

enum SubscriptionStatus {
  TRIAL           // Free 30-day trial
  ACTIVE          // Paid and current
  PAST_DUE        // Payment failed, grace period
  EXPIRED         // Trial or subscription ended
  CANCELLED       // User cancelled
}

enum SubscriptionPlan {
  MONTHLY         // 65 TND/month
  YEARLY          // 650 TND/year (2 months free)
}

model DailyStat {
  id            String   @id @default(uuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  date                DateTime @db.Date
  dayOfWeek           Int      @default(0)   // 0=Sun..6=Sat

  // Volume
  totalPatients       Int      @default(0)
  completed           Int      @default(0)
  noShows             Int      @default(0)
  cancelled           Int      @default(0)

  // Timing averages (kept for backward compatibility)
  avgWaitMins         Int?
  avgConsultationMins Int?

  // Richer timing (enables accurate cross-day averaging)
  maxWaitMins         Int?
  minWaitMins         Int?
  totalWaitMins       Int      @default(0)   // Sum of all wait times in minutes
  totalConsultMins    Int      @default(0)   // Sum of all consultation durations
  patientsWithWait    Int      @default(0)   // Count with valid wait data
  patientsWithConsult Int      @default(0)   // Count with valid consult data

  // Check-in method breakdown
  checkInQr           Int      @default(0)
  checkInManual       Int      @default(0)
  checkInWhatsapp     Int      @default(0)

  // Walk-in vs appointment
  walkIns             Int      @default(0)
  appointments        Int      @default(0)
  emergencies         Int      @default(0)

  // Pre-computed
  peakHour            Int?     // 0-23, busiest arrival hour

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clinicId, date])
  @@index([clinicId, date])
  @@index([clinicId, dayOfWeek])
}

model HourlyStat {
  id             String   @id @default(uuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  hour           Int      // 0-23
  dayOfWeek      Int      // 0=Sun..6=Sat

  // Counts
  arrivals          Int   @default(0)
  completed         Int   @default(0)
  noShows           Int   @default(0)

  // Timing (sums for accurate cross-hour/day averaging)
  totalWaitMins     Int   @default(0)
  totalConsultMins  Int   @default(0)
  patientsWithWait  Int   @default(0)

  // Method breakdown
  checkInQr         Int   @default(0)
  checkInManual     Int   @default(0)

  createdAt      DateTime @default(now())

  @@unique([clinicId, date, hour])
  @@index([clinicId, dayOfWeek, hour])
  @@index([clinicId, date])
}

model DoctorDailyStat {
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  id             String   @id @default(uuid())
  clinicId       String
  doctorId       String

  date           DateTime @db.Date

  totalPatients     Int   @default(0)
  completed         Int   @default(0)
  noShows           Int   @default(0)
  totalWaitMins     Int   @default(0)
  totalConsultMins  Int   @default(0)
  patientsWithWait  Int   @default(0)
  patientsWithConsult Int @default(0)

  createdAt      DateTime @default(now())

  @@unique([clinicId, doctorId, date])
  @@index([clinicId, date])
  @@index([doctorId, date])
}


model PaymentRecord {
  id         String   @id @default(uuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  amount     Int      // Amount in millimes (65000 = 65 TND)
  month      DateTime @db.Date  // Payment for which month (first day of month)
  method     String   // "konnect", "bank_transfer", "cash", "cheque"
  reference  String?  // Konnect paymentRef or bank transfer ref
  notes      String?
  status     String   @default("paid") // "paid", "pending", "failed"

  paidAt     DateTime @default(now())
  recordedBy String   // Admin email who recorded it

  createdAt  DateTime @default(now())

  @@unique([clinicId, month])
  @@index([clinicId])
  @@index([month])
}

// Track subscription lifecycle events
model SubscriptionEvent {
  id            String   @id @default(uuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  eventType     String   // trial_started, trial_expired, payment_success, payment_failed, subscription_activated, subscription_cancelled
  amount        Int?     // Amount in millimes (if payment related)
  paymentRef    String?  // Konnect reference
  notes         String?

  createdAt     DateTime @default(now())

  @@index([clinicId])
  @@index([eventType])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  entryId   String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  entry     QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model Lead {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("teaser") // "teaser", "landing", etc.
  createdAt DateTime @default(now())

  @@index([createdAt])
}
