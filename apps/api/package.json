{
  "name": "@doctorq/api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env BRAND=blesaf PORT=3001 FRONTEND_URL=http://localhost:5200 tsx watch src/index.ts",
    "dev:tn": "cross-env BRAND=blesaf PORT=3001 FRONTEND_URL=http://localhost:5200 tsx watch src/index.ts",
    "dev:fr": "cross-env BRAND=france PORT=3010 FRONTEND_URL=http://localhost:5190 tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:prod": "tsx prisma/seed-production.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@sentry/node": "^10.38.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.6.1",
    "stripe": "^20.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
