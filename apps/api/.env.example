# Database
# Use Supabase pooler URL (Transaction mode) for runtime queries
DATABASE_URL="postgresql://user:password@localhost:5432/doctorq?schema=public"
# Use Supabase direct URL (Session mode) for migrations — required by prisma migrate
DIRECT_URL="postgresql://user:password@localhost:5432/doctorq?schema=public"

# Auth
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# WhatsApp (future)
WHATSAPP_BUSINESS_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Brand (blesaf | france)
BRAND="blesaf"

# App
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Payment - Konnect (Tunisia, BRAND=blesaf)
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""

# Payment - Stripe (France, BRAND=france)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL=""

# Admin emails (comma-separated)
ADMIN_EMAILS="admin@doctorq.tn"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Supabase Auth (for social login / SSO)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Error Tracking (Sentry)
SENTRY_DSN=""
