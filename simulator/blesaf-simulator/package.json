{
  "name": "blesaf-simulator",
  "version": "1.0.0",
  "description": "Clinic day-in-the-life simulator for BleSaf queue management",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "sim": "ts-node src/index.ts",
    "sim:single": "ts-node src/index.ts --clinic 0",
    "report:latest": "cat reports/$(ls -t reports/ | head -1)"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
