{
  "name": "doctorq",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Virtual queue management system for Tunisian medical practices",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @doctorq/api dev",
    "dev:web": "pnpm --filter @doctorq/web dev",
    "dev:tn": "concurrently \"pnpm dev:api:tn\" \"pnpm dev:web:tn\"",
    "dev:fr": "concurrently \"pnpm dev:api:fr\" \"pnpm dev:web:fr\"",
    "dev:all": "concurrently \"pnpm dev:api:tn\" \"pnpm dev:web:tn\" \"pnpm dev:api:fr\" \"pnpm dev:web:fr\"",
    "dev:api:tn": "pnpm --filter @doctorq/api dev:tn",
    "dev:api:fr": "pnpm --filter @doctorq/api dev:fr",
    "dev:web:tn": "pnpm --filter @doctorq/web dev:tn",
    "dev:web:fr": "pnpm --filter @doctorq/web dev:fr",
    "build": "pnpm --filter @doctorq/api build && pnpm --filter @doctorq/web build",
    "build:api": "pnpm --filter @doctorq/api build",
    "build:web": "pnpm --filter @doctorq/web build",
    "test": "pnpm --recursive test",
    "test:api": "pnpm --filter @doctorq/api test",
    "test:web": "pnpm --filter @doctorq/web test",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:push": "pnpm --filter @doctorq/api db:push",
    "db:migrate": "pnpm --filter @doctorq/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @doctorq/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @doctorq/api db:migrate:status",
    "db:seed": "pnpm --filter @doctorq/api db:seed",
    "db:studio": "pnpm --filter @doctorq/api db:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
